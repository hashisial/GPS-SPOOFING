{
  "name": "gps-spoofing-dashboard",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "database"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace frontend\" \"npm run dev --workspace backend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "start": "concurrently \"npm run start --workspace frontend\" \"npm run start --workspace backend\"",
    "db:up": "docker compose -f database/docker-compose.yml up -d",
    "db:down": "docker compose -f database/docker-compose.yml down",
    "db:generate": "npm run generate --workspace database",
    "db:migrate": "npm run migrate --workspace database",
    "db:seed": "npm run seed --workspace database",
    "postinstall": "npm run db:generate"
  },
  "devDependencies": {
    "concurrently": "latest"
  }
}
